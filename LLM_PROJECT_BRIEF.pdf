(5\) App Structure) Tj
T*
(Key folders/files:) Tj
T*
(? app/_layout.tsx: App shell and stack navigation, wraps app in ListProvider) Tj
T*
(? app/index.tsx: Home screen \(lists, search UI, create-list CTA\)) Tj
T*
(? app/create-list/index.tsx: Create list screen with store picker) Tj
T*
(? app/list/[id].tsx: List details \(add/edit/delete items, start-shopping CTA\)) Tj
T*
(? lib/state/listContext.tsx: Global list + item state and CRUD operations) Tj
T*
(? lib/types.ts: Type models \(GroceryList, GroceryItem, Store\)) Tj
T*
(? constants/stores.ts: Store catalog used by create-list) Tj
T*
() Tj
T*
